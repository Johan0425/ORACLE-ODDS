# ─────────────────────────────────────────────────────────────
# ORACLE ODDS — referencia completa (API, worker y web)
# Nunca subas este archivo con valores reales.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Base de datos (local: docker compose). En Neon: pooled en DATABASE_URL, directa en _UNPOOLED.
DATABASE_URL="postgresql://oracle:oracle@localhost:5432/oracle_odds?schema=public"
DATABASE_URL_UNPOOLED="postgresql://oracle:oracle@localhost:5432/oracle_odds?schema=public"
# Redis (local) o REDIS_URL=rediss://default:<password>@<host>:<port> (Upstash)
REDIS_URL=redis://localhost:6379
# Solo el proceso worker consume colas; la API HTTP no.
ENABLE_SYNC_WORKER=false
# inline = jobs por endpoint de cron (Vercel); bullmq = worker persistente
QUEUE_MODE=bullmq
CRON_SECRET=
CRON_TIME_BUDGET_MS=240000

# Seguridad
CORS_ORIGIN=http://localhost:3000
SYNC_ADMIN_SECRET=
ANON_HASH_SALT=
INTERNAL_API_TOKEN=
METRICS_TOKEN=
PUBLIC_WEB_URL=http://localhost:3000
THROTTLE_GLOBAL_LIMIT=120
SENTRY_DSN=

# Localización
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_LOCALE=es-CO
DEFAULT_REGION=co

# Proveedores (sin clave = estado "sin configurar"; nunca se inventan datos)
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_PER_MINUTE=10
# IDs de liga de API-Football, p. ej. 39 (Premier), 140 (LaLiga), 2 (Champions)
TRACKED_LEAGUES=
API_FOOTBALL_SEASON=
ENABLE_API_FOOTBALL_ODDS=false

THE_ODDS_API_KEY=
THE_ODDS_API_MONTHLY_LIMIT=500
ODDS_REGIONS=eu,uk
ODDS_MARKETS=h2h,totals,spreads
# sport_keys de The Odds API, p. ej. soccer_epl,soccer_spain_la_liga
ODDS_SPORT_KEYS=
ENABLE_HISTORICAL_ODDS=false

ODDS_API_IO_KEY=
ENABLE_ODDS_API_IO=false
ODDS_API_IO_COMPETITIONS=

THESPORTSDB_KEY=

# Casas verificadas como autorizadas para el territorio (slugs/keys del proveedor de cuotas)
ALLOWED_BOOKMAKERS=
VIG_METHOD=power

# Publicación de oportunidades
PUBLISH_REQUIRE_CALIBRATION=true
CALIBRATION_MIN_SAMPLES=300
CALIBRATION_MAX_ECE=0.05
VALUE_MIN_EDGE=0.02
VALUE_MIN_EV=0.02
VALUE_MIN_QUALITY=55
VALUE_MIN_BOOKMAKERS=2
VALUE_MIN_CONFIDENCE=0.35
VALUE_MAX_ODDS=10
ENABLE_LIVE_PICKS=false
LIVE_MAX_LATENCY_SECONDS=90

# BetSantander (desactivado hasta verificar operador, licencia y acuerdo)
BET_SANTANDER_ENABLED=false
BET_SANTANDER_URL=https://www.betsantander.com/
BET_SANTANDER_AFFILIATE_ID=
BET_SANTANDER_CAMPAIGN=
BET_SANTANDER_LOGO_URL=
BET_SANTANDER_VERIFIED_AT=
BET_SANTANDER_LICENSE_LABEL=
BET_SANTANDER_ALLOWED_COUNTRIES=CO
BET_SANTANDER_POSTBACK_SECRET=

# Retos
TURNSTILE_SECRET_KEY=
CHALLENGE_DAILY_CREATE_LIMIT=5

# Telegram (publicación opcional de picks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
ENABLE_TELEGRAM_PUBLISH=false

# ── Frontend (apps/web/.env.local) ──
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota
NEXT_PUBLIC_DEFAULT_LOCALE=es-CO
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
