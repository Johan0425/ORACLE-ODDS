# URL pública de la API (navegador). Ejemplo producción: https://api.oracleodds.example/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# URL interna para el render en servidor (opcional; si no, usa NEXT_PUBLIC_API_URL)
API_URL=http://localhost:3001/api/v1
# URL pública del sitio (enlaces compartibles, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota
NEXT_PUBLIC_DEFAULT_LOCALE=es-CO
# Cloudflare Turnstile (opcional, CAPTCHA antiabuso en retos)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
INTERNAL_API_TOKEN=
