    },
    {
      "path": "/api/v1/cron/odds?h=16",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/v1/cron/odds?h=19",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/v1/cron/odds?h=22",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/v1/cron/model?h=5",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/v1/cron/model?h=17",
      "schedule": "45 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
