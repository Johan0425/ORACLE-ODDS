# --- Local (docker compose / Colima) ---
DATABASE_URL="postgresql://oracle:oracle@localhost:5432/oracle_odds?schema=public"
# Prisma requiere que directUrl resuelva siempre, aunque local no tenga pooler real.
DATABASE_URL_UNPOOLED="postgresql://oracle:oracle@localhost:5432/oracle_odds?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
# BullMQ asume un proceso persistente — solo tiene sentido en runtimes de contenedor
# (Docker/Colima local), nunca en un deploy serverless (Vercel).
ENABLE_SYNC_WORKER=true

# --- Producción serverless (Vercel): dejar ENABLE_SYNC_WORKER sin definir (false) ---
# DATABASE_URL="<connection string pooled de Neon>"            # PgBouncer, para la app
# DATABASE_URL_UNPOOLED="<connection string directa de Neon>"  # sin pooler, para `prisma migrate`
# REDIS_URL="rediss://default:<password>@<host>:<port>"        # Upstash (TLS) — solo si ENABLE_SYNC_WORKER=true
# CORS_ORIGIN="https://tu-proyecto.vercel.app"                 # sin esto, CORS abierto (solo dev)

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
API_FOOTBALL_KEY=
THE_ODDS_API_KEY=
THESPORTSDB_KEY=3
SPORTS_GAME_ODDS_KEY=
PORT=3001
