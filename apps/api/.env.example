# --- Local (docker compose / Colima) ---
DATABASE_URL="postgresql://oracle:oracle@localhost:5432/oracle_odds?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Producción (Render): dejar REDIS_HOST/REDIS_PORT vacíos y usar REDIS_URL en su lugar ---
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"   # Neon
# REDIS_URL="rediss://default:<password>@<host>:<port>"                      # Upstash (TLS)
# CORS_ORIGIN="https://tu-proyecto.vercel.app"                               # sin esto, CORS abierto (solo dev)

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
API_FOOTBALL_KEY=
THE_ODDS_API_KEY=
THESPORTSDB_KEY=3
SPORTS_GAME_ODDS_KEY=
PORT=3001
