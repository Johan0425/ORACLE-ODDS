{
  "title": "ORACLE ODDS \u2014 Operaci\u00f3n",
  "uid": "oracle-odds-ops",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Jobs por estado",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (job,status) (increase(oracle_job_runs_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Frescura por proveedor/job (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (provider,job) (oracle_data_freshness_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cupo restante por proveedor",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min by (provider) (oracle_provider_quota_remaining)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fallos de proveedor",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (provider,outcome) (increase(oracle_provider_requests_total{outcome!=\"success\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Entidades normalizadas / duplicados",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (entity,action) (increase(oracle_entities_normalized_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Latencia de proveedores p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,provider) (rate(oracle_provider_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Oportunidades activas",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "oracle_value_bets_active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Liquidaciones",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (kind,result) (increase(oracle_settlements_total[1d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Clics de afiliado por ubicaci\u00f3n",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (placement) (increase(oracle_affiliate_clicks_total[1d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Errores HTTP 5xx",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(oracle_http_request_duration_seconds_count{status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Brier / ECE por mercado (backtest)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "oracle_model_quality{source=\"backtest\",metric=~\"brier|ece\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "ROI y CLV (liquidadas)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "oracle_betting_performance{metric=~\"roi|clv\"}",
          "refId": "A"
        }
      ]
    }
  ]
}